{
  "name": "p5-renderer",
  "version": "1.0.0",
  "description": "Puppeteer renderer for p5.brush generated code",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node -e \"if (!process.env.RENDERER_SHUTDOWN_TOKEN) process.env.RENDERER_SHUTDOWN_TOKEN = require('crypto').randomBytes(16).toString('hex'); require('./server.js');\"",
    "test": "node test_security.js"
  },
  "dependencies": {
    "express": "^4.22.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^23.4.0"
  }
}
